{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gfavaro/WinMuxX/blob/main/docs/schemas/winmuxx.schema.json",
  "title": "WinMuxX configuration",
  "description": "Editor assistance for WinMuxX TOML. The app's Swift parser remains authoritative; command strings and monitor selectors need runtime validation.",
  "type": "object",
  "properties": {
    "config-version": {"type": "integer", "minimum": 1, "maximum": 2},
    "appearance": {"enum": ["system", "light", "dark"]},
    "after-startup-command": {"$ref": "#/$defs/commands"},
    "on-display-changed": {"$ref": "#/$defs/commands"},
    "on-focus-changed": {"$ref": "#/$defs/commands"},
    "on-mode-changed": {"$ref": "#/$defs/commands"},
    "on-focused-monitor-changed": {"$ref": "#/$defs/commands"},
    "enable-normalization-flatten-containers": {"type": "boolean"},
    "enable-normalization-opposite-orientation-for-nested-containers": {"type": "boolean"},
    "default-root-container-layout": {"$ref": "#/$defs/layout"},
    "default-root-container-orientation": {"$ref": "#/$defs/orientation"},
    "start-workspaces-on-main-monitor": {"type": "boolean"},
    "start-at-login": {"type": "boolean"},
    "auto-reload-config": {"type": "boolean"},
    "automatically-unhide-macos-hidden-apps": {"type": "boolean"},
    "automatically-tile-new-windows": {"type": "boolean"},
    "enable-shake-to-toggle-tiling": {"type": "boolean"},
    "focus-follows-mouse": {"type": "boolean"},
    "master": {"$ref": "#/$defs/master"},
    "follow-app-activation": {"oneOf": [{"type": "boolean"}, {"$ref": "#/$defs/followAppActivation"}]},
    "shortcuts-preset": {"type": "string", "deprecated": true, "description": "The removed rectangle preset is rejected by the parser."},
    "persistent-workspaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "exec-on-workspace-change": {"type": "array", "items": {"type": "string"}, "deprecated": true},
    "exec": {"type": "object", "description": "Command environment configuration."},
    "auto-add-new-windows-to-tab-group": {"type": "boolean"},
    "single-window-aspect-ratio": {"$ref": "#/$defs/dynamicNumber", "deprecated": true},
    "fullscreen-width": {"$ref": "#/$defs/fullscreenWidth"},
    "display": {"type": "object", "patternProperties": {"^.+$": {"$ref": "#/$defs/windowWidthSettings"}}, "additionalProperties": false},
    "gaps": {"$ref": "#/$defs/gaps"},
    "workspace-swipe": {"$ref": "#/$defs/workspaceSwipe"},
    "workspace-overview": {"type": "object", "properties": {"three-finger-up": {"type": "boolean"}}, "additionalProperties": false},
    "workspace-sidebar": {"$ref": "#/$defs/workspaceSidebar"},
    "menu-bar": {"type": "object", "properties": {"indicator": {"enum": ["icon", "workspace"]}, "icon-appearance": {"enum": ["color", "monochrome"]}}, "additionalProperties": false},
    "window-tabs": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "height": {"type": "integer", "exclusiveMinimum": 20}, "double-sided-windows": {"type": "boolean"}}, "additionalProperties": false},
    "borders": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "width": {"type": "number", "minimum": 0}, "active-color": {"type": "string", "pattern": "^([Aa][Cc][Cc][Ee][Nn][Tt]|#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?)$"}, "inactive-color": {"type": "string", "pattern": "^([Aa][Cc][Cc][Ee][Nn][Tt]|#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?)$"}, "order": {"enum": ["below", "above"]}, "exclude-apps": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "dimming": {"type": "object", "properties": {"inactive-windows": {"type": "number", "minimum": 0, "maximum": 0.8}}, "additionalProperties": false},
    "modifiers": {"type": "object", "patternProperties": {"^(alt|ctrl|cmd|shift)$": {"enum": ["both", "left", "right"]}}, "additionalProperties": false},
    "animations": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "duration-ms": {"type": "integer", "minimum": 0, "maximum": 2000}}, "additionalProperties": false},
    "workspace": {"type": "object", "description": "Dynamic keys are internal workspace names.", "patternProperties": {"^.+$": {"$ref": "#/$defs/workspaceLayout"}}, "additionalProperties": false},
    "workspace-to-monitor-force-assignment": {"type": "object", "patternProperties": {"^.+$": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "on-window-detected": {"type": "array", "items": {"type": "object", "properties": {"if": {"type": "object"}, "run": {"$ref": "#/$defs/commands"}}, "required": ["run"], "additionalProperties": true}},
    "mode": {"type": "object", "description": "Dynamic mode names and binding tables; command strings are validated by WinMuxX.", "patternProperties": {"^.+$": {"type": "object"}}, "additionalProperties": false},
    "key-mapping": {"type": "object", "description": "Dynamic key names and keyboard mapping values."}
  },
  "additionalProperties": false,
  "$defs": {
    "layout": {"enum": ["dwindle", "master", "tiles", "accordion", "tab-group", "tabbed"]},
    "workspaceArrangement": {"enum": ["dwindle", "master", "tabbed"]},
    "orientation": {"enum": ["horizontal", "vertical", "auto"]},
    "commands": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "dynamicNumber": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "array", "items": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}}]},
    "master": {"type": "object", "properties": {"size": {"type": "number", "minimum": 0.1, "maximum": 0.9}, "side": {"enum": ["left", "right", "top", "bottom"]}}, "additionalProperties": false},
    "followAppActivation": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "exclude-apps": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "dynamicInt": {"oneOf": [{"type": "integer"}, {"type": "array", "items": {"type": "object", "additionalProperties": {"type": "integer"}}}]},
    "gaps": {"type": "object", "properties": {"inner": {"type": "object", "properties": {"horizontal": {"$ref": "#/$defs/dynamicInt"}, "vertical": {"$ref": "#/$defs/dynamicInt"}}, "additionalProperties": false}, "outer": {"type": "object", "properties": {"left": {"$ref": "#/$defs/dynamicInt"}, "right": {"$ref": "#/$defs/dynamicInt"}, "top": {"$ref": "#/$defs/dynamicInt"}, "bottom": {"$ref": "#/$defs/dynamicInt"}}, "additionalProperties": false}}, "additionalProperties": false},
    "workspaceSwipe": {"type": "object", "properties": {"enabled": {"type": "boolean"}}, "additionalProperties": false},
    "fullscreenWidth": {"type": "number", "minimum": 0.1, "maximum": 1.0},
    "windowWidthSettings": {"type": "object", "properties": {"fullscreen-width": {"$ref": "#/$defs/fullscreenWidth"}}, "additionalProperties": false},
    "workspaceLayout": {"type": "object", "properties": {"layout": {"$ref": "#/$defs/workspaceArrangement"}, "orientation": {"$ref": "#/$defs/orientation"}, "display": {"type": "object", "patternProperties": {"^.+$": {"type": "object", "properties": {"layout": {"$ref": "#/$defs/workspaceArrangement"}, "orientation": {"$ref": "#/$defs/orientation"}, "fullscreen-width": {"$ref": "#/$defs/fullscreenWidth"}}, "additionalProperties": false}}, "additionalProperties": false}, "fullscreen-width": {"$ref": "#/$defs/fullscreenWidth"}}, "additionalProperties": false},
    "workspaceSidebar": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "enable-focus": {"type": "boolean"}, "auto-hide": {"type": "boolean"}, "always-expanded": {"type": "boolean"}, "collapsed-width": {"type": "integer", "minimum": 1}, "width": {"type": "integer", "minimum": 1}, "position": {"enum": ["left", "right"]}, "height-mode": {"enum": ["standard", "centered", "full"]}, "monitor": {"type": "array", "items": {"type": "string"}}, "show-clock": {"type": "boolean"}, "show-seconds": {"type": "boolean"}, "show-date": {"type": "boolean"}, "show-weekday": {"type": "boolean"}, "menu-bar-background": {"type": "boolean"}, "chrome-style": {"enum": ["liquid-glass", "solid"]}, "solid-chrome-color": {"type": "string"}, "solid-chrome-custom-color": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"}, "workspace-labels": {"type": "object", "additionalProperties": {"type": "string"}}, "project-labels": {"type": "object", "additionalProperties": {"type": "string"}}, "project-colors": {"type": "object", "additionalProperties": {"type": "string"}}, "appearance": {"enum": ["system", "custom"], "deprecated": true}, "background": {"enum": ["sidebar", "menu-bar", "transparent"], "deprecated": true}, "frosted-tint": {"enum": ["automatic", "white", "black", "cyan", "pink", "indigo", "purple", "ice", "aurora"], "deprecated": true}}, "additionalProperties": false}
  }
}
